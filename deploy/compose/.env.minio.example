# MinIO admin identity. Copy to .env.minio (untracked) and replace every
# CHANGE_ME value. This file is loaded only by the minio and minio-init
# services. Do not copy these names into .env — the relay's env_file: .env
# would import them into the relay container.
#
# Distinct from the relay's BUZZ_S3_* keys in .env. minio-init creates
# those keys as a user with s3:GetObject/PutObject/DeleteObject on
# BUZZ_S3_BUCKET only.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
