#!/usr/bin/env python3
"""
build-routing: Regenerate ROUTING.md by harvesting technique frontmatter.

Reads all .md files from techniques/ directory, extracts name, summary and
reach-for-when from frontmatter, and generates a markdown table mapping
symptom shapes to techniques.
"""

import sys
import os
import re
from pathlib import Path
from typing import Dict, List, Tuple

def get_techniques_dir() -> Path:
    """Find the techniques directory relative to this script."""
    script_dir = Path(__file__).parent
    skill_dir = script_dir.parent
    return skill_dir / 'techniques'

def parse_frontmatter(content: str) -> Dict:
    """
    Parse YAML-like frontmatter from markdown file.

    Returns dict with parsed frontmatter, or raises an exception.
    """
    match = re.match(r'^---\s*\n(.*?)\n---\s*\n', content, re.DOTALL)
    if not match:
        raise ValueError("No frontmatter found")

    yaml_content = match.group(1)
    return parse_simple_yaml(yaml_content)

def parse_simple_yaml(content: str) -> Dict:
    """
    Simple YAML parser for technique frontmatter.

    Handles: simple key: value, and indented list items.
    """
    result = {}
    lines = content.strip().split('\n')
    current_list_key = None

    for line in lines:
        # Determine indentation before stripping
        indent = len(line) - len(line.lstrip())
        line_stripped = line.strip()

        if not line_stripped or line_stripped.startswith('#'):
            continue

        # Check if it's a list item (indented and starts with - )
        if line_stripped.startswith('- '):
            if current_list_key is None:
                raise ValueError(f"List item without parent key: {line_stripped}")
            value = line_stripped[2:].strip()
            result[current_list_key].append(value)
            continue

        # Check if it's a key: value line (should be at root indent)
        if ':' in line_stripped and indent == 0:
            key, _, value = line_stripped.partition(':')
            key = key.strip()
            value = value.strip()

            current_list_key = None  # Reset list context
            if value:
                result[key] = value
            else:
                # Empty value might be start of a list
                result[key] = []
                current_list_key = key
            continue

        raise ValueError(f"Invalid YAML line: {line_stripped}")

    return result

def read_techniques() -> List[Tuple[str, Dict, List[str]]]:
    """
    Read all technique files and extract routing info.

    Returns list of tuples: (technique_name, frontmatter, reach_for_when_list)
    """
    techniques_dir = get_techniques_dir()

    if not techniques_dir.exists():
        return []

    results = []
    technique_files = sorted([f for f in techniques_dir.glob('*.md') if f.name != '_TEMPLATE.md'])

    for filepath in technique_files:
        try:
            content = filepath.read_text(encoding='utf-8')
            frontmatter = parse_frontmatter(content)

            name = frontmatter.get('name', '')
            summary = frontmatter.get('summary', '')
            reach_for_when = frontmatter.get('reach-for-when', [])

            if not isinstance(reach_for_when, list):
                reach_for_when = [reach_for_when] if reach_for_when else []

            results.append((name, {
                'summary': summary,
                'reach-for-when': reach_for_when
            }, reach_for_when))
        except Exception as e:
            sys.stderr.write(f"Error reading {filepath.name}: {e}\n")
            return None

    return results

def build_routing_table(techniques: List[Tuple[str, Dict, List[str]]]) -> str:
    """
    Build markdown routing table from technique data.

    Returns markdown table as string.
    """
    if not techniques:
        lines = ["| Symptom shape | Reach for |", "|---|---|"]
        return '\n'.join(lines)

    # Collect all (symptom, technique_name) pairs
    rows = []
    for tech_name, metadata, reach_for_when in techniques:
        for symptom in reach_for_when:
            rows.append((symptom, tech_name))

    # Sort by symptom shape to keep related shapes together
    rows.sort(key=lambda x: x[0].lower())

    # Build table
    lines = [
        "| Symptom shape | Reach for |",
        "|---|---|"
    ]
    for symptom, tech_name in rows:
        lines.append(f"| {symptom} | {tech_name} |")

    return '\n'.join(lines)

def generate_output(techniques: List[Tuple[str, Dict, List[str]]]) -> str:
    """Generate complete ROUTING.md content."""
    banner = "<!-- Generated by build-routing — do not edit -->\n"
    table = build_routing_table(techniques)
    return banner + "\n" + table + "\n"

def main():
    output_file = False

    # Check for -o flag
    if '-o' in sys.argv:
        output_file = True
        sys.argv.remove('-o')

    if len(sys.argv) > 1:
        sys.stderr.write(f"Usage: {sys.argv[0]} [-o]\n")
        sys.stderr.write("  -o: Write to ROUTING.md (default: print to stdout)\n")
        sys.exit(2)

    try:
        techniques = read_techniques()
        if techniques is None:
            sys.exit(2)

        content = generate_output(techniques)

        if output_file:
            routing_path = get_techniques_dir().parent / 'ROUTING.md'
            routing_path.write_text(content, encoding='utf-8')
        else:
            sys.stdout.write(content)

        sys.exit(0)
    except Exception as e:
        sys.stderr.write(f"Error: {e}\n")
        sys.exit(2)

if __name__ == '__main__':
    main()
